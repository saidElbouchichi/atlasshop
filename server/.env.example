# Copier ce fichier en .env puis remplir les valeurs. Ne jamais committer .env.

# development en local, production sur Render (sans cette variable, l'API se comporte comme en production)
NODE_ENV=development
PORT=5000

# MongoDB Atlas : Database > Connect > Drivers
MONGO_URI=mongodb+srv://UTILISATEUR:MOT_DE_PASSE@cluster.exemple.mongodb.net/atlasshop

# Secret de signature des JWT : 32 caractères minimum.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origines autorisées par CORS, séparées par des virgules (la première sert aux retours Stripe)
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Stripe en mode test (clés sk_test_... et whsec_...). Optionnel : sans ces clés, seul le paiement
# à la livraison est proposé. Si STRIPE_SECRET_KEY est renseignée, STRIPE_WEBHOOK_SECRET est obligatoire.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paiement simulé, pour développer sans compte Stripe. N'a d'effet qu'avec NODE_ENV=development ou test.
# Ne jamais définir sur Render.
ALLOW_FAKE_PAYMENT=false

# Cloudinary (upload des images produits depuis l'admin)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mots de passe des comptes créés par « npm run seed » (8 caractères minimum)
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
# Le seed EFFACE les collections. Sur une base distante (Atlas), il exige cette confirmation :
# SEED_FORCE=true
